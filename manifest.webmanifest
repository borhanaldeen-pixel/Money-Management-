{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/money-management-app",
  "name": "منظومة الراتب والمصروف ودفتر الديون",
  "short_name": "المنظومة المالية",
  "description": "منظومة موحدة لإدارة الراتب والمصروف اليومي ودفتر الديون، وتعمل بدون إنترنت.",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "./index.html",
  "scope": "./",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone",
    "window-controls-overlay"
  ],
  "orientation": "portrait-primary",
  "background_color": "#0b0716",
  "theme_color": "#53051D",
  "categories": [
    "finance",
    "productivity",
    "utilities"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "الواجهة الرئيسية للمنظومة المالية"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "واجهة سطح المكتب للمنظومة المالية"
    }
  ]
}
